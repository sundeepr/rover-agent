# /etc/udev/rules.d/99-rover-cameras.rules
#
# Stable /dev/cam-* symlinks matched by physical USB port.
#
# Physical layout:
#   usb-3610000.usb-1.1  →  /dev/video4  →  front camera (5MP, unique VID:PID 32e4:0335)
#   usb1/1-2.1           →  /dev/video0  →  left  wheel camera (Logitech C270)
#   usb1/1-2.3           →  /dev/video2  →  right wheel camera (Logitech C270)
#
# Logitech C270 cameras are video-only (no audio interface) so no
# snd-usb-audio unbind is needed.
#
# Install:
#   sudo cp 99-rover-cameras.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Verify symlinks:
#   ls -la /dev/cam-*
#   # expected: cam-front→video4  cam-left→video0  cam-right→video2

# ── Left wheel camera (C270 on USB port 1-2.1) ───────────────────────────────
SUBSYSTEM=="video4linux", \
  KERNELS=="1-2.1:1.0", \
  ATTR{index}=="0", \
  SYMLINK+="cam-left", MODE="0666", TAG+="systemd"

# ── Right wheel camera (C270 on USB port 1-2.3) ───────────────────────────────
SUBSYSTEM=="video4linux", \
  KERNELS=="1-2.3:1.0", \
  ATTR{index}=="0", \
  SYMLINK+="cam-right", MODE="0666", TAG+="systemd"

# ── Front camera (5MP, unique VID:PID — port match not needed) ───────────────
SUBSYSTEM=="video4linux", \
  ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="0335", \
  ATTR{index}=="0", \
  SYMLINK+="cam-front", MODE="0666", TAG+="systemd"
